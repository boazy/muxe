_muxe_commands() {
    local commands; commands=(
'init:Create the starter configuration without installing host integration' \
'menu:Open a configured root menu through a host launcher' \
'pane:Open a generic command pane' \
'integration:Install or remove managed host integration' \
'activate:Activate this version for selected live hosts' \
'broker:Manage broker lifecycle' \
'compatibility:Print the embedded compatibility record' \
'purge:Remove explicitly selected retained Muxe data' \
'ui:Run the native terminal UI' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'muxe commands' commands "$@"
}
